// Caret-native tests for every successfully executable feature in the prototype.
// Run with: ./run.sh test examples/implemented_features_test.caret

// Scalar values, type inspection, and string escapes.
assertEqual "integer number" 42 42
assertEqual "decimal number" 3.5 3.5
assertEqual "string value" "text" "text"
assertEqual "Boolean true" true true
assertEqual "Boolean false" false false
assertEqual "null value" ? ?
assertEqual "missing value" ~ ~
assertEqual "null and missing differ" (? == ~) false
assertEqual "number type" (type 42) "Number"
assertEqual "null type" (type ?) "Null"
assertEqual "escaped string" "quote: \" slash: \\ tab: \t smile: \u{1F642}" "quote: \" slash: \\ tab: \t smile: 🙂"

// Bindings, functions, lexical lookup, and implicit zero-argument invocation.
base = 10
add left right = left + right
scale value =
  factor = 2
  value * factor

answer =
  40 + 2

assertEqual "binding lookup" base 10
assertEqual "function application" (add 2 3) 5
assertEqual "multiline function body" (scale base) 20
increment = + _ 1
assertEqual "prefix symbolic operator" (+ 2 3) 5
assertEqual "prefix and infix operators agree" (+ 2 3) (2 + 3)
assertEqual "plus exposes four closed variants" (seqSize @(+).variants) 4

coverageConstructor = [_2 _1 _1]
assertEqual "collection literals own numbered holes" (coverageConstructor "same" 2) [2 "same" "same"]
coverageContractedConstructor = [[(Number) _] _]
assertEqual "nested collection holes share one constructor" (coverageContractedConstructor 3 "tail") [[3] "tail"]

CoveragePoint = template [(Number) _ (Number) _]
assert "structural template accepts exact matching shape" (CoveragePoint [1 2])
assert "structural template rejects wrong members" (not CoveragePoint [1 "two"])
CoverageDiagonal = template [_1 _1]
assert "repeated template holes impose equality" (CoverageDiagonal [3 3])
assertEqual "symbolic operator partial" (increment 5) 6
assertEqual "grouped prefix subtraction" ((-) 7 2) 5
assertEqual "zero-argument function invocation" answer 42
assertEqual "zero-argument function reflection kind" (@answer).kind "Function"
assertEqual "zero-argument function reflection arity" (@answer).remaining 0

// Direct and mutual recursion.
factorial n = n == 0 & 1 ! n * factorial (n - 1)
even n = n == 0 & true ! odd (n - 1)
odd n = n == 0 & false ! even (n - 1)

assertEqual "direct recursion" (factorial 5) 120
assert "mutual recursion even" (even 8)
assertEqual "mutual recursion odd" (odd 8) false

// Grouping, precedence, arithmetic, comparison, equality, and Boolean operators.
assertEqual "operator precedence" (1 + 2 * 3) 7
assertEqual "grouped application" (add (add 1 2) 3) 6
assertEqual "unary negation" (-5 + 8) 3
assertEqual "division" (7 / 2) 3.5
assertEqual "remainder" (7 % 2) 1
assert "less-than comparison" (2 < 3)
assert "less-than-or-equal comparison" (3 <= 3)
assert "greater-than comparison" (4 > 3)
assert "greater-than-or-equal comparison" (4 >= 4)
assert "inequality" (2 != 3)
assert "Boolean not" (not false)
assertEqual "string concatenation" ("left" + "right") "leftright"

// Short-circuit Boolean operations and conditional expressions.
assertEqual "and short-circuits" (false and unknownAnd) false
assert "or short-circuits" (true or unknownOr)
assertEqual "conditional selects true branch" (true & "selected" ! unknownConditional) "selected"
assertEqual "conditional selects false branch" (false & unknownConditional ! "fallback") "fallback"
assertEqual "conditional defaults to missing" (false & unknownConditional) ~
assertEqual "null is false in a conditional" (? & unknownConditional ! "fallback") "fallback"
assertEqual "missing is false in a conditional" (~ & unknownConditional ! "fallback") "fallback"

// Ordinary and numbered holes, argument reordering, and argument reuse.
between low value high = value >= low and value <= high
inside = between 0 _ 10
digits a b c = a * 100 + b * 10 + c
reordered = digits _2 2 _1
join left right = left + right
duplicated = join _1 _1

assert "ordinary partial application" (inside 7)
assertEqual "numbered holes reorder arguments" (reordered 1 3) 321
assertEqual "numbered holes reuse arguments" (duplicated "x") "xx"

// Named Collections, privacy, optional access, dynamic lookup, and structural equality.
makePerson name age =
  privateAge = age + 1
  ^name = name
  ^age = age

person = makePerson "Ada" 36
samePerson = [^name = "Ada" ^age = 36]
fieldName = "name"

assertEqual "required exported field" person.name "Ada"
assertEqual "second exported field" person.age 36
assertEqual "private binding is hidden" person.privateAge~ ~
assertEqual "optional absent field" person.phone~ ~
assert "export shorthand equals a named literal" (person == samePerson)
assertEqual "dynamic field lookup" person[fieldName]~ "Ada"
assertEqual "dynamic string lookup" person["age"]~ 36
assertEqual "required dynamic lookup" person["age"] 36
assertEqual "optional dynamic lookup" person["phone"]~ ~

// Reflection exposes only public metadata and does not invoke functions.
assertEqual "dictionary reflection kind" (@person).kind "Dictionary"
assertEqual "collection reflection shape" (@person).shape "named"
assertEqual "collection reflection size" (@person).size 2
assertEqual "collection reflection names" (@person).names "age,name"
assertEqual "function reflection kind" (@factorial).kind "Function"
assertEqual "function reflection remaining arity" (@factorial).remaining 1
factorialReference = @factorial
assertEqual "function metadata type" (type factorialReference) "Dictionary"
assert "function metadata is structural" (factorialReference == @factorial)
assertEqual "different function metadata is unequal" (factorialReference == @add) false
assertEqual "operator metadata kind" (@(+)).kind "Function"
assertEqual "operator metadata remaining arity" (@(+)).remaining 2
assertEqual "function metadata optional field" factorialReference.absent~ ~
factorialAlias = factorialReference:
assertEqual "function metadata dereferences" (factorialAlias 5) 120
assertEqual "null reflection kind" (@?).kind "Null"
assertEqual "missing reflection kind" (@~).kind "Missing"
assertEqual "number reflection kind" (@42).kind "Number"

// Explicit grouping and dynamic lookup may span physical lines.
multiline = (
  add
    20
    22
)
multilineField = person[
  "name"
]~

assertEqual "multiline grouped call" multiline 42
assertEqual "multiline dynamic lookup" multilineField "Ada"

ungroupedMultiline = add
  10
  scale
    10
assertEqual "ungrouped multiline call" ungroupedMultiline 30

joinDigits left right = left * 10 + right
assertEqual "named infix call" (2 joinDigits 3) 23
assertEqual "named infix is left associative" (1 joinDigits 2 joinDigits 3) 123
assertEqual "named infix binds below addition" (2 joinDigits 3 + 4) 27
assert "named infix binds above comparison" (2 joinDigits 3 < 30)

applyInfix left operation right = left operation right
applyPrefix operation left right = operation left right
assertEqual "callable parameter in infix position" (applyInfix 2 add 3) 5
assertEqual "callable parameter in prefix position" (applyPrefix add 2 3) 5

joinLater = joinDigits _ _
assertEqual "multiple ordinary holes fill left to right" (joinLater 4 5) 45

// Unicode code-point text primitives and safe conversion failures.
unicodeText = "🙂ab"
assertEqual "text size counts code points" (textSize unicodeText) 3
assertEqual "textAt returns a code point" (textAt unicodeText 0) "🙂"
assertEqual "textSlice uses half-open bounds" (textSlice unicodeText 1 3) "ab"
assertEqual "textAt invalid index is missing" (textAt unicodeText 99) ~
assertEqual "textNumber parses finite numbers" (textNumber "12.5") 12.5
assertEqual "textNumber failure is missing" (textNumber "not a number") ~
assertEqual "numberText formats a number" (numberText 12.5) "12.5"

// Persistent sequences.
emptySequence = seqEmpty
sequence = seqAdd (seqAdd emptySequence "first") ~
sameSequence = seqAdd (seqAdd seqEmpty "first") ~
extendedSequence = seqAdd sequence "third"

assertEqual "empty sequence size" (seqSize emptySequence) 0
assertEqual "sequence append is persistent" (seqSize sequence) 2
assertEqual "earlier sequence remains unchanged" (seqSize sequence) 2
assertEqual "extended sequence has new element" (seqSize extendedSequence) 3
assertEqual "sequence first element" (seqGet sequence 0) "first"
assertEqual "sequence present missing element" (seqGet sequence 1) ~
assertEqual "sequence invalid index" (seqGet sequence 99) ~
assert "sequence structural equality" (sequence == sameSequence)
assert "nested numeric equality follows scalar equality" (seqAdd seqEmpty (-0) == seqAdd seqEmpty 0)
assertEqual "sequence reflection kind" (@sequence).kind "Sequence"
assertEqual "sequence reflection size" (@sequence).size 2

// Persistent canonically ordered Dictionaries with String keys.
emptyDictionary = dictEmpty
oneEntry = dictPut emptyDictionary "present" 1
dictionary = dictPut oneEntry "missingValue" ~
sameDictionary = dictPut (dictPut dictEmpty "present" 1) "missingValue" ~
replacedDictionary = dictPut dictionary "present" 2

assertEqual "empty dictionary remains unchanged" (dictHas emptyDictionary "present") false
assert "dictionary has key" (dictHas dictionary "present")
assert "dictionary distinguishes present missing value" (dictHas dictionary "missingValue")
assertEqual "dictionary lookup" (dictGet dictionary "present") 1
assertEqual "dictionary present missing lookup" (dictGet dictionary "missingValue") ~
assertEqual "dictionary absent lookup" (dictGet dictionary "absent") ~
assertEqual "dictionary canonical keys" (dictKeys dictionary) (seqAdd (seqAdd seqEmpty "missingValue") "present")
assertEqual "dictionary replacement changes the new value" (dictGet replacedDictionary "present") 2
assertEqual "dictionary replacement preserves key order" (dictKeys replacedDictionary) (dictKeys dictionary)
assertEqual "earlier dictionary remains unchanged" (dictGet dictionary "present") 1
assert "nested dictionary and sequence equality is structural" (dictPut dictEmpty "nested" sequence == dictPut dictEmpty "nested" sequence)
assert "dictionary structural equality" (dictionary == sameDictionary)
assertEqual "dictionary reflection kind" (@dictionary).kind "Dictionary"
assertEqual "dictionary reflection size" (@dictionary).size 2
assertEqual "dictionary reflection names" (@dictionary).names "missingValue,present"

// Left-to-right function composition, chaining, partials, and reflection.
double value = value * 2
incrementOne value = value + 1
addThenDouble = add >> double
addTenThenText = add _ 10 >> numberText
pipeline = double >> incrementOne >> numberText
assertEqual "multi-argument composition" (addThenDouble 2 3) 10
assertEqual "partial left composition" (addTenThenText 5) "15"
assertEqual "composition chain" (pipeline 2) "5"
assertEqual "composition retains left arity" (@addThenDouble).remaining 2

// Contract identity equality and public requirement reflection.
positive value = value > 0
Positive = contract positive
PositiveAlias = Positive
OtherPositive = contract positive
Required = [Number positive]
RequiredAgain = [Number positive]
CompositeOne = contract Required
CompositeTwo = contract RequiredAgain
assert "contract alias retains identity" (Positive == PositiveAlias)
assert "separate contracts have distinct identity" (Positive != OtherPositive)
assert "identical requirement lists do not imply equality" (CompositeOne != CompositeTwo)
assertEqual "contract reflection lists refinements" (@Positive).requirements ["positive"]

Diamond = contract [Left Right Root]
Right = contract Root
Left = contract Root
Root = contract ~
(Diamond) diamondValue = "diamond"
assert "forward diamond retains left membership" (Left diamondValue)
assert "forward diamond retains transitive root membership" (Root diamondValue)

NumberOrNull = Number?
NumberOrMissing = Number~
NumberOrAbsent = Number?~
assert "nullable contract accepts null" (NumberOrNull ?)
assert "nullable contract rejects missing" (not NumberOrNull ~)
assert "optional contract accepts missing" (NumberOrMissing ~)
assert "optional contract rejects null" (not NumberOrMissing ?)
assert "combined contract accepts numbers" (NumberOrAbsent 1)
assert "combined contract accepts null" (NumberOrAbsent ?)
assert "combined contract accepts missing" (NumberOrAbsent ~)
assertEqual "modified contract reflection name" (@NumberOrAbsent).name "Number?~"
assertEqual "modified contract reflection base" (@NumberOrAbsent).bases ["Number"]
assert "redundant nullable modifier normalizes" (Null? == Null)
assert "modified contract identity is stable" (Number? == Number?)
(Positive?) positiveValue = 2
assert "modified nominal clause acquires base membership" (Positive positiveValue)
assert "grouped modifiers flatten to canonical identity" ((Number?)~ == Number?~)

// Low-precedence application is right-associative and remains below ordinary expressions.
coverageLowIdentity value = value
assertEqual "low application associates right" (add 1 $ 2 * 3) 7
assertEqual "low application accepts a conditional remainder" (coverageLowIdentity $ false & "unused" ! "selected") "selected"

// Explicit layout mapping produces the same exported named Collection as ordinary indentation.
coverageLayout = \\
value = 40
^result = value + 2
\*
assertEqual "layout mapping exports its result" coverageLayout.result 42

// Collection construction order and canonical field order remain separate guarantees.
coverageNamed = [^with = 1 ^z = 2 ^a = 3]
coverageFields = [(field "z" 2) (field "a" 3) (field "with" 1)]
coverageUpdates = dictPut (dictPut (dictPut dictEmpty "with" 1) "z" 2) "a" 3
assertEqual "reserved words may be collection fields" coverageNamed.with 1
assertEqual "field construction matches literal construction" coverageNamed coverageFields
assertEqual "dictionary updates retain canonical identity-independent order" coverageFields coverageUpdates
assertEqual "canonical reflected field names" (@coverageNamed).names "a,with,z"

// map accepts current callable kinds and preserves null, missing, and nested values.
coverageMapAdd left right = left + right
assertEqual "map handles an empty sequence" (map double []) []
assertEqual "map invokes a named callable" (map double [1 2 3]) [2 4 6]
assertEqual "map invokes a prefix partial" (map (coverageMapAdd 10) [1 2]) [11 12]
assertEqual "map invokes a composition" (map (double >> double) [1 2]) [4 8]
assertEqual "map identity preserves absence and nesting" (map coverageLowIdentity [? ~ [1 2]]) [? ~ [1 2]]

// Inference retains generic flow, numeric and string constraints, truth, and conditional joins.
coverageInferIdentity value = value
coverageIncrement value = coverageInferIdentity value * 1 + 1
coverageSuffix value = value + "!"
coverageNegate value = not value
coverageChooseNumber condition = condition & coverageIncrement 4 ! coverageIncrement 8
(Number) coverageDeclaredConstant (Number) ignored = 1
assertEqual "inferred generic identity accepts text" (coverageInferIdentity "generic") "generic"
assertEqual "inferred generic identity accepts numbers" (coverageInferIdentity 42) 42
assertEqual "inferred numeric result survives a conditional" (coverageChooseNumber true) 5
assertEqual "inferred truth accepts null" (coverageChooseNumber ?) 9
assertEqual "inferred string plus" (coverageSuffix "works") "works!"
assert "inferred Boolean negation" (coverageNegate false)
assertEqual "declared and inferred parameters stay separate" (seqSize (seqGet (@coverageDeclaredConstant).signature.parameters 0).inferred) 0

// Pure predicates are first-class refinements and retain eligibility through aliases.
coveragePositive value = value > 0
coveragePredicate = coveragePositive
CoveragePositiveNumber = contract [Number coveragePredicate]
(CoveragePositiveNumber) coverageCount = 3
(Number coveragePositive) coverageKeep (Number coveragePositive) value = value
assertEqual "refinement clause accepts a proven value" (coverageKeep coverageCount) 3
assert "derived refinement contract accepts its member" (CoveragePositiveNumber coverageCount)

// Parameterized contracts validate nested Sequences and expose constructor metadata.
CoverageNumbers = Sequence Number
(Sequence Number) coverageNumbers = [1 2 3]
CoverageNestedNumbers = Sequence (Sequence Number)
(CoverageNestedNumbers) coverageNestedNumbers = [[1 2] [] [3]]
assert "parameterized Sequence accepts matching elements" (CoverageNumbers coverageNumbers)
assert "nested parameterized Sequence accepts matching elements" (CoverageNestedNumbers coverageNestedNumbers)
assertEqual "parameterized contract reflection retains its name" (@CoverageNumbers).name "Sequence Number"
assertEqual "parameterized contract reflection retains its argument" (@CoverageNumbers).requirements ["Number"]

// Closed overloads select the unique most-specific variant and specialize partials.
coverageDescribe (Any) value = "fallback"
coverageDescribe (Number) value = "number"
coverageDescribe (String) value = "text"
coverageCombine (Any) left (Any) right = "fallback"
coverageCombine (Number) left (Number) right = "numbers"
coverageNumberPair = coverageCombine _ 2
assertEqual "overload selects Number" (coverageDescribe 42) "number"
assertEqual "overload selects String" (coverageDescribe "hello") "text"
assertEqual "overload retains generic fallback" (coverageDescribe true) "fallback"
assertEqual "overload partial narrows survivors" (coverageNumberPair 1) "numbers"

CoverageRoot = contract ~
CoverageLeft = contract CoverageRoot
CoverageRight = contract CoverageRoot
CoverageBoth = contract [CoverageLeft CoverageRight CoverageRoot]
coverageSpecific (Any) value = "fallback"
coverageSpecific (CoverageLeft) value = "left"
coverageSpecific (CoverageBoth) value = "both"
(CoverageBoth) coverageBothValue = 1
assertEqual "normalized diamond overload is most specific" (coverageSpecific coverageBothValue) "both"
assertEqual "overload reflection exposes exact variants" (seqSize (@coverageDescribe).variants) 3

// Arrow contracts inspect signatures without invocation and preserve generalized relationships.
(Number) coverageArrowDouble (Number) value = value + value
(Number) coverageApply ([Number] -> Number) transform (Number) value = transform value
CoverageNumberTransform = [Number] -> Number
CoverageBroadTransform = [Any] -> Number
CoverageLooseResult = [Number] -> Any
assert "exact arrow contract accepts a matching callable" (CoverageNumberTransform coverageArrowDouble)
assertEqual "arrow parameter rejects a callable with a narrower domain" (CoverageBroadTransform coverageArrowDouble) false
assert "covariant arrow result accepts a stronger guarantee" (CoverageLooseResult coverageArrowDouble)
assertEqual "arrow-constrained higher-order call" (coverageApply coverageArrowDouble 21) 42

(Number) coverageArrowSafe (Any) value = 1
(String) coverageArrowSafe (String) value = "text"
(Number) coverageArrowUnsafe (Any) value = 1
(String) coverageArrowUnsafe (Number) value = "text"
assert "whole-domain fallback with disjoint variant satisfies arrow contract" (CoverageNumberTransform coverageArrowSafe)
assertEqual "overlapping incompatible result rejects overload arrow contract" (CoverageNumberTransform coverageArrowUnsafe) false

(_1) coverageChoose (_1) left (_1) right = left
coverageNumberChoice = coverageChoose 1
coverageHoleChoice = coverageChoose _ 2
assertEqual "generalized prefix partial specializes" (coverageNumberChoice 2) 1
assertEqual "generalized hole partial specializes" (coverageHoleChoice 1) 1
assertEqual "signature variables use canonical indices" (seqGet (seqGet (@coverageChoose).signature.parameters 0).requirements 0).index 0
assertEqual "specialized variable becomes a concrete descriptor" (seqGet (seqGet (@coverageNumberChoice).signature.parameters 0).requirements 0).name "Number"

// Callable reflection exposes current partial, hole, composition, overload, and identity views.
(Number) coverageSignatureAdd (Number) left (Number) right = left + right
coverageSignatureAddOne = coverageSignatureAdd 1
coverageSignatureAlias = @coverageSignatureAdd:
coverageSignature = (@coverageSignatureAdd).signature
coverageFirstParameter = seqGet coverageSignature.parameters 0
(Number) coverageSignatureCombine (Number) left (String) right = 0
coverageRepeated = coverageSignatureCombine _1 _1
coverageReordered = coverageSignatureCombine _2 _1
(String) coverageText (String) value = value
coveragePipeline = coverageInferIdentity >> coverageText
assertEqual "callable reflection retains arity" (@coverageSignatureAdd).remaining 2
assertEqual "callable reflection exposes declared requirements" (seqGet coverageFirstParameter.requirements 0).name "Number"
assertEqual "prefix partial reflection drops a parameter" (@coverageSignatureAddOne).remaining 1
assertEqual "prefix partial reflection retains the next name" (seqGet (@coverageSignatureAddOne).signature.parameters 0).name "right"
assertEqual "pure signature exposes a known-empty bound" (seqSize coverageSignature.effects.upperBound) 0
assertEqual "reflected callable dereference preserves its target" (coverageSignatureAlias 2 3) 5
assertEqual "repeated holes conjoin requirements" (seqSize (seqGet (@coverageRepeated).signature.parameters 0).requirements) 2
assertEqual "reordered holes expose application order" (seqGet (@coverageReordered).signature.parameters 0).name "right"
assertEqual "reordered holes retain the second source name" (seqGet (@coverageReordered).signature.parameters 1).name "left"
assertEqual "composition specializes its public parameter" (seqGet (seqGet (@coveragePipeline).signature.parameters 0).requirements 0).name "String"
assertEqual "composition exposes its final guarantee" (seqGet (@coveragePipeline).signature.result.guarantees 0).name "String"
coverageSavedMetadata = @coverageSignatureAdd
assert "repeated reflection preserves callable identity" (coverageSavedMetadata == @coverageSignatureAdd)
assertEqual "saved metadata remains dereferenceable" (coverageSavedMetadata: 3 4) 7

// Mixed clauses separate value requirements, effect allowances, and pure callable constraints.
(Output Number) coverageNoisy (Number) value = value
(pure) coveragePureCopy = coverageInferIdentity
CoverageEffectfulNumber = [Number] -> (Output Number)
assert "effectful arrow accepts a declared allowance" (CoverageEffectfulNumber coverageNoisy)
assertEqual "pure callable constraint preserves behavior" (coveragePureCopy 2) 2
coverageNoisySignature = (@coverageNoisy).signature
assertEqual "mixed result clause contains only its value requirement" (seqGet coverageNoisySignature.result.declared 0).name "Number"
assertEqual "mixed result clause exposes its effect separately" (seqGet coverageNoisySignature.effects.declared 0).name "Output"

// Rendering overloads are tested last so they cannot alter earlier test diagnostics.
(String) toString (Number) value = "number:" + numberText value
(String) toString (String) value = value
assertEqual "rendering overload handles String" (toString "plain") "plain"
assertEqual "rendering overload handles Number" (toString 7) "number:7"
assertEqual "custom rendering applies inside Sequences" (toString [1 2]) "[ number:1 number:2 ]"
assertEqual "custom rendering applies recursively in named Collections" (toString [^name = "Caret" ^values = [1 2]]) "[\n  \"name\" = \"Caret\"\n  \"values\" = [ number:1 number:2 ]\n]"

// Expected failures are isolated in examples/errors/ and exercised by test.sh.
