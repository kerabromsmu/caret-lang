// Every currently implemented Caret language feature in one runnable program.

// Values: finite numbers, strings, Booleans, null, and missing.
print 42
print 3.5
print "text"
print true
print false
print ?
print ~
print type 42
print type ?

// Strings support standard escapes and Unicode code-point escapes.
escaped = "quote: \" slash: \\ tab: \t smile: \u{1F642}"
print escaped

// Bindings, one-line functions, indented function bodies, and lexical lookup.
base = 10
add a b = a + b
scale value =
  factor = 2
  value * factor
print add 2 3
print scale base

// Symbolic binary operators are the same callable values in prefix and infix form.
increment = + _ 1
print + 2 3
print increment 5
print (-) 7 2

// Zero-argument functions are invoked when read.
answer =
  40 + 2
print answer
print (@answer).kind
print (@answer).remaining

// Direct and mutual recursion.
factorial n = n == 0 & 1 ! n * factorial (n - 1)
even n = n == 0 & true ! odd (n - 1)
odd n = n == 0 & false ! even (n - 1)
print factorial 5
print even 8
print odd 8

// Grouping, precedence, unary operators, arithmetic, comparison, and equality.
print (1 + 2 * 3)
print (-5 + 8)
print (7 / 2)
print (7 % 2)
print (2 < 3 and 3 <= 3)
print (4 > 3 and 4 >= 4)
print (2 != 3)
print not false
print ("left" + "right")

// and/or and conditional branches short-circuit.
print (false and unknownAnd)
print (true or unknownOr)
print (true & "selected" ! unknownConditional)
print (false & unknownConditional ! "fallback")
print (false & unknownConditional)
print (? & unknownConditional ! "null is false")
print (~ & unknownConditional ! "missing is false")

// Ordinary holes, eager fixed-operand capture, numbered reordering, and reuse.
between low value high = value >= low and value <= high
inside = between 0 _ 10
print inside 7

first left right = left
(Output) announce value = print value
captured = first (announce "captured now") _
print captured "ignored"

digits a b c = a * 100 + b * 10 + c
reordered = digits _2 2 _1
print reordered 1 3
join left right = left + right
duplicated = join _1 _1
print duplicated "x"

// Exported blocks and explicit named Collections are equivalent and compare structurally.
makePerson name age =
  privateAge = age + 1
  ^name = name
  ^age = age

person = makePerson "Ada" 36
samePerson = [^name = "Ada" ^age = 36]
print person.name
print person.age
print person.privateAge~
print person.phone~
print (person == samePerson)

// String dynamic lookup and safe missing lookup.
fieldName = "name"
print person[fieldName]~
print person["age"]~
print person["age"]
print person["phone"]~

// Reflection exposes value kind and public metadata without invoking functions.
print (@person).kind
print (@person).shape
print (@person).size
print (@person).names
print (@factorial).kind
print (@factorial).remaining
factorialReference = @factorial
print type factorialReference
print factorialReference == @factorial
print factorialReference == @add
print (@+).kind
print (@+).remaining
print factorialReference.absent~
print (@?).kind
print (@~).kind
print (@42).kind

// Grouped expressions and dynamic lookups may span physical lines.
multiline = (
  add
    20
    22
)
print multiline
print person[
  "name"
]~

// More-indented lines are ungrouped call arguments; nested indentation creates nested calls.
ungroupedMultiline = add
  10
  scale
    10
print ungroupedMultiline

// Named binary functions also use fixed-precedence, left-associative infix notation.
joinDigits left right = left * 10 + right
print 2 joinDigits 3
print 1 joinDigits 2 joinDigits 3
print 2 joinDigits 3 + 4
print (2 joinDigits 3 < 30)

// Callable parameters use the same runtime prefix/infix selection rule.
applyInfix left operation right = left operation right
applyPrefix operation left right = operation left right
print applyInfix 2 add 3
print applyPrefix add 2 3

// Multiple ordinary holes are filled from left to right.
joinLater = joinDigits _ _
print joinLater 4 5

// Text indexes count Unicode code points; slices use [start, end).
unicodeText = "🙂ab"
print textSize unicodeText
print textAt unicodeText 0
print textSlice unicodeText 1 3
print textAt unicodeText 99
print textNumber "12.5"
print textNumber "not a number"
print numberText 12.5

// Sequences are immutable and use safe indexed lookup.
emptySequence = seqEmpty
sequence = seqAdd (seqAdd emptySequence "first") ~
extendedSequence = seqAdd sequence "third"
print seqSize emptySequence
print seqSize sequence
print seqSize extendedSequence
print seqGet sequence 0
print seqGet sequence 1
print seqGet sequence 99
print (sequence == seqAdd (seqAdd seqEmpty "first") ~)
print (seqAdd seqEmpty (-0) == seqAdd seqEmpty 0)
print (@sequence).kind
print (@sequence).size

// Dictionaries are immutable, ordered, and use string keys.
emptyDictionary = dictEmpty
oneEntry = dictPut emptyDictionary "present" 1
dictionary = dictPut oneEntry "missingValue" ~
replacedDictionary = dictPut dictionary "present" 2
print dictHas emptyDictionary "present"
print dictHas dictionary "present"
print dictHas dictionary "missingValue"
print dictGet dictionary "present"
print dictGet dictionary "missingValue"
print dictGet dictionary "absent"
print dictKeys dictionary
print dictGet replacedDictionary "present"
print dictKeys replacedDictionary
print (dictPut dictEmpty "nested" sequence == dictPut dictEmpty "nested" sequence)
print (@dictionary).kind
print (@dictionary).size
print (@dictionary).names

// Composition is left-to-right, binds above $, and supports partial left callables.
double value = value * 2
incrementOne value = value + 1
addThenDouble = add >> double
addTenThenText = add _ 10 >> numberText
pipeline = double >> incrementOne >> numberText
print addThenDouble 2 3
print addTenThenText 5
print pipeline 2
print (@addThenDouble).remaining

// Contracts compare by identity and expose public refinement requirement metadata.
positive value = value > 0
Positive = contract positive
PositiveAlias = Positive
OtherPositive = contract positive
Required = [Number positive]
RequiredAgain = [Number positive]
CompositeOne = contract Required
CompositeTwo = contract RequiredAgain
print (Positive == PositiveAlias)
print (Positive == OtherPositive)
print (CompositeOne == CompositeTwo)
print (@Positive).requirements

// $ is right-associative application below composition, conditionals, and ordinary operators.
print $ add 1 $ 2 * 3
print $ false & "unselected" ! "conditional argument"

// Executable diagnostic examples live in examples/errors/ and are indexed by examples/README.md.
