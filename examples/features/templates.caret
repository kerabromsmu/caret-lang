Point = template [(Number) _ (Number) _]
Diagonal = template [_1 _1]
Person = template [^name = (String) _ ^active = true]

dynamicName = "score"
Scored = template [
  field dynamicName (Number) _
]

print Point [1 2]
print Point [1 "two"]
print Diagonal [3 3]
print Diagonal [3 4]
print Person [^name = "Caret" ^active = true]
print Scored [^score = 9]
print (@Person).shape
print (@Person).size
print (seqGet (@Person).elements 0).constraint
print (seqGet (@Person).elements 0).id
print (seqGet (@Person).elements 0).name~

Contact = template [^name = (String) _ ^phone = (String~) _]
(Contact) ada = [^name = "Ada"]
identity (Contact) value = value
print ada.phone
print Contact ada
print Contact [^name = "Ada"]
print (identity [^name = "Bo"]).phone
print (seqGet @Contact.elements 1).defaultsMissing
