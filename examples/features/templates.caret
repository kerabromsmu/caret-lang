Point = template [(Number) _ (Number) _]
Diagonal = template [_1 _1]
Person = template [^name = (String) _ ^active = true]

dynamicName = "score"
Scored = template [
  field dynamicName (Number) _
]

print Point [1 2]
print Point [1 "two"]
print Diagonal [3 3]
print Diagonal [3 4]
print Person [^name = "Caret" ^active = true]
print Scored [^score = 9]
print (@Person).shape
print (@Person).size
print (seqGet (@Person).elements 0).constraint
print (seqGet (@Person).elements 0).id
print (seqGet (@Person).elements 0).name~

Contact = template [^name = (String) _ ^phone = (String~) _]
(Contact) ada = [^name = "Ada"]
identity (Contact) value = value
print ada.phone
print Contact ada
print Contact [^name = "Ada"]
print (identity [^name = "Bo"]).phone
print (seqGet @Contact.elements 1).defaultsMissing

// Template sugar keeps ordinary template and hole semantics.
SugarPoint = <[(Number) _ (Number) _]>
SugarDiagonal = <[_1 _1]>
SugarContact = <[^name = (String) _ ^phone = (String~) _]>
Address = <[^street = (String) _ ^city = (String) _]>
Resident = <[^name = (String) _ ^address = (Address) _]>

print SugarPoint [3 4]
print SugarPoint [3 "four"]
print SugarDiagonal [2 2]
(SugarContact) bo = [^name = "Bo"]
print bo.phone
print Resident [^name = "Ada" ^address = [^street = "Main" ^city = "Oslo"]]

localSugar =
  template specimen = seqSize specimen
  <[1 2]>
print localSugar
