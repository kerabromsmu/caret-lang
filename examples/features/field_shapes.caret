// Fields are two-position Collections whose contract distinguishes them from ordinary pairs.
item = field "name" 2
print Field String Number item
print Collection item
print keys item
print values item
print (@item).key
print (@item).value
print Field ["name" 2]

// Missing keys contribute keyless content; fully omitted Fields contribute nothing.
keyless = [(field ~ 1) 2 (field ~ 3) (field ~ ~)]
print keyless

// Context selects Set versus Dictionary when associated values are missing.
(Set Number) members = [3 1 3 (field 2 ~)]
print keys members
print values members
print fields members

(Dictionary String Any) stored = [(field "present" 1) (field "missing" ~)]
print keys stored
print values stored
print dictHas stored "missing"

// Dictionary enumeration sorts homogeneous keys; general keyed Collections retain entry order.
(Dictionary Number String) ordered = [(field 2 "b") (field 1 "a")]
print keys ordered
general = [(field [2] "b") (field [1] "a")]
print keys general

// Construction settles with the first equal key and neutralizes fully omitted output.
duplicate = [(field "same" 1) (field "same" 2)]
print duplicate.same
neutral = [(field ~ ~)]
print neutral
print isKeyed neutral
