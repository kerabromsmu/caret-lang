(Number) initial = 2

Tag = contract ~
Numeric = contract Number
Both = contract [Tag Numeric]

(Numeric) add (Numeric) left (Numeric) right =
  left + right

addTen = add 10

print Number initial
print String initial
print addTen 5
print type Number
print (@Number).name
print (@Both).name
print (@Both).bases

(Numeric) index = 1
(Tag) tagged = "keeps its ordinary behavior"
print seqGet ["zero" "one"] index
print tagged
print [(1 + 2 * 3) (add 2 3)]

(Number?) nullable = ?
(Number~) optional = ~
NumberOrAbsent = Number?~
print NumberOrAbsent 3
print NumberOrAbsent ?
print NumberOrAbsent ~
print Number? ~
print (@NumberOrAbsent).name
print (@NumberOrAbsent).bases

(Numeric?) nullableNumeric = 4
print Numeric nullableNumeric
DerivedNullable = contract Numeric?
(DerivedNullable) derivedNullable = 5
print Numeric derivedNullable

Numbers = Sequence Number
(Sequence Number) numbers = [1 2 3]
NestedNumbers = Sequence (Sequence Number)
(NestedNumbers) nestedNumbers = [[1 2] [] [3]]
print Numbers numbers
print NestedNumbers nestedNumbers
print (@Numbers).name
print (@Numbers).requirements

Diamond = contract [Left Right Root]
Right = contract Root
Left = contract Root
Root = contract ~
(Diamond) diamondValue = "diamond"
print Root diamondValue
