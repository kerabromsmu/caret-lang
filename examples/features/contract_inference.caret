identity value =
  value

increment value =
  identity value * 1 + 1

suffix value =
  value + "!"

negate value =
  not value

(Number) declaredConstant (Number) ignored =
  1

chooseNumber condition =
  condition & increment 4 ! increment 8

print identity "generic text"
print identity 42
print chooseNumber true
print chooseNumber ?
print suffix "works"
print negate false
print seqSize (seqGet (@declaredConstant).signature.parameters 0).inferred
