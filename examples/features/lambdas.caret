double = x -> x * 2
add = left right -> left + right
makeAdder amount = value -> value + amount
addThree = makeAdder 3
addTen = add 10
reverseSubtract = (left right -> left - right) _2 _1
answer = -> 42

trailingFunctions = seqAdd []
  value -> value * 2
dollarFunctions = seqAdd [] $ value -> value + 1
pipeline = (value -> value + 1) >> (value -> value * 2)
noisy = value ->
  print value
  value

print double 4
print add 2 5
print addThree 4
print addTen 5
print reverseSubtract 3 10
print answer
print (seqGet trailingFunctions 0) 5
print (seqGet dollarFunctions 0) 6
print pipeline 3
print (seqSize (@double).signature.effects.upperBound)
print (seqSize (@noisy).signature.effects.upperBound)
print (seqGet (@noisy).signature.effects.upperBound 0).id
print (@double).kind
print (@double).id
print (@double).remaining
